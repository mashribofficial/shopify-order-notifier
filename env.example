# Shopify: the webhook signing secret (Admin > Settings > Notifications > Webhooks, shown at the bottom)
SHOPIFY_WEBHOOK_SECRET=
STORE_NAME=My Store

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender number, e.g. +15551234567
TWILIO_FROM=
# "sms" or "whatsapp" (for whatsapp, TWILIO_FROM must be your WhatsApp-enabled sender)
CHANNEL=sms

# Used when the customer enters a local number like 0300 1234567
DEFAULT_COUNTRY_CODE=92

# Message template. Placeholders: {name} {order_number} {total} {currency} {store}
MESSAGE_TEMPLATE=Hi {name}, thanks for your order {order_number} at {store}! Total: {currency} {total}. We'll update you when it ships.

# true = log messages instead of sending (good for testing)
DRY_RUN=true
PORT=3000
